{
  "manifest_version": 3,
  "name": "Ghost Bridge",
  "version": "0.4.0",
  "description": "Authenticated native Chrome bridge for ghost-cli.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/ghost-16.png",
      "48": "icons/ghost-48.png",
      "128": "icons/ghost-128.png"
    }
  },
  "icons": {
    "16": "icons/ghost-16.png",
    "48": "icons/ghost-48.png",
    "128": "icons/ghost-128.png"
  }
}
